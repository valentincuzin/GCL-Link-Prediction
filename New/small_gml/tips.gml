      source 756
      target 3857
      tip_text "Try the Goodburger Salad With Crabby Patty - #sweet #delicious crab cake on top of a #healthy #organic salad. (via @Foodspotting)"
   ]
   edge [
      id 4837
      source 756
      target 4667
      tip_text "Try the Tongue Sandwich - #yummy #inappropriate #goaheadandmakefunofmeidareyou (via @Foodspotting)"
   ]
   edge [
      id 4838
      source 757
      target 753
      tip_text "Pricey but a BK must. GIFT IDEA--ship a cheesecake (in that amazing striped box) to a friend."
   ]
   edge [
      id 4839
