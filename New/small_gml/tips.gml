      tip_text "Solid old school slices in Hell's Kitchen \/ Clinton."
   ]
   edge [
      id 4834
      source 756
      target 3604
      tip_text "Try the Katsu Curry - #addictive! I love Go Go Curry and it's mostly empty today. I'm the only European-American here. Konichiwa! (via @Foodspotting)"
   ]
   edge [
